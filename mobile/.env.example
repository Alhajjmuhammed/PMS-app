# Mobile App Environment Configuration
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env file with real credentials

# API Base URL (REQUIRED)
# Development examples:
#   - iOS Simulator:     EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
#   - Android Emulator:  EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#   - Physical Device:   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
#
# Production (MUST use HTTPS):
#   EXPO_PUBLIC_API_BASE_URL=https://api.yourhotel.com
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Note: The app will automatically:
# - Use HTTP for development builds (__DEV__ = true)
# - Enforce HTTPS for production builds (__DEV__ = false)
# - Throw an error if production build attempts to use HTTP
