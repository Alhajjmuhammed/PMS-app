# ============================================================================
# HOTEL PMS - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure your values
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================
# SECRET_KEY: Django secret key for cryptographic signing
# SECURITY: Generate a new secret key for production! Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production-hotel-pms-2025

# DEBUG: Enable/disable debug mode (ALWAYS False in production!)
DEBUG=True

# ALLOWED_HOSTS: Comma-separated list of allowed host/domain names
# Production example: yourdomain.com,app.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ENVIRONMENT: Current environment (development, staging, production)
ENVIRONMENT=development

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
# Development (SQLite) - Good for local development
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Production (PostgreSQL) - Recommended for production
# Uncomment these lines for production and comment out SQLite settings above
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=hotel_pms
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_strong_password_here
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_SSL_MODE=require  # For cloud databases

# Alternative: Database URL format (overrides individual settings if set)
# DATABASE_URL=postgresql://user:password@localhost:5432/hotel_pms

# ============================================================================
# REDIS & CACHING
# ============================================================================
# REDIS_URL: Redis connection URL for caching and Celery
# Format: redis://:password@hostname:port/db_number
# Examples:
#   Local: redis://127.0.0.1:6379/1
#   With password: redis://:your_password@127.0.0.1:6379/1
#   Cloud (Redis Labs): redis://:password@hostname:port/0
REDIS_URL=redis://127.0.0.1:6379/1

# ============================================================================
# CELERY TASK QUEUE
# ============================================================================
# CELERY_BROKER_URL: Message broker for Celery (usually same as Redis)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# CELERY_RESULT_BACKEND: Results backend for Celery
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CELERY_TASK_ALWAYS_EAGER: Run tasks synchronously (True for dev, False for prod)
CELERY_TASK_ALWAYS_EAGER=False

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# SSL/HTTPS Settings (Enable in production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Production SSL Settings (uncomment for production):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# CORS_ALLOW_ALL_ORIGINS: Allow all origins (True for dev, False for production)
CORS_ALLOW_ALL_ORIGINS=True

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins (use in production)
# Example: https://yourdomain.com,https://app.yourdomain.com,https://mobile.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# CSRF_TRUSTED_ORIGINS: Trusted origins for CSRF (required for production)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# MULTI-FACTOR AUTHENTICATION (MFA)
# ============================================================================
# MFA_ISSUER_NAME: Display name for TOTP authenticator apps
MFA_ISSUER_NAME=Hotel PMS

# ============================================================================
# EMAIL SETTINGS
# ============================================================================
# EMAIL_BACKEND: Email backend to use
# Development: django.core.mail.backends.console.EmailBackend (prints to console)
# Production: django.core.mail.backends.smtp.EmailBackend (sends real emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (for production email sending)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourhotel.com
SERVER_EMAIL=server@yourhotel.com

# Email service providers:
# Gmail: smtp.gmail.com:587 (requires app-specific password)
# SendGrid: smtp.sendgrid.net:587
# Mailgun: smtp.mailgun.org:587
# AWS SES: email-smtp.us-east-1.amazonaws.com:587

# ============================================================================
# SMS SETTINGS (Twilio)
# ============================================================================
# TWILIO_ACCOUNT_SID: Your Twilio Account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# TWILIO_AUTH_TOKEN: Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# TWILIO_PHONE_NUMBER: Your Twilio phone number (E.164 format)
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ============================================================================
# FCM_SERVER_KEY: Firebase Cloud Messaging server key
FCM_SERVER_KEY=your_firebase_server_key

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Stripe Settings
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Settings
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # sandbox or live

# ============================================================================
# CHANNEL MANAGER / OTA INTEGRATIONS
# ============================================================================
# Booking.com API
BOOKING_API_KEY=your_booking_api_key
BOOKING_API_SECRET=your_booking_api_secret

# Expedia API
EXPEDIA_API_KEY=your_expedia_api_key
EXPEDIA_API_SECRET=your_expedia_api_secret

# Airbnb API
AIRBNB_API_KEY=your_airbnb_api_key
AIRBNB_API_SECRET=your_airbnb_api_secret

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# SENTRY_DSN: Sentry error tracking DSN (leave empty to disable)
# Get from: https://sentry.io/
SENTRY_DSN=

# LOG_LEVEL: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# TOKEN & SESSION SETTINGS
# ============================================================================
# TOKEN_EXPIRATION_HOURS: Hours before auth token expires
TOKEN_EXPIRATION_HOURS=24

# SESSION_COOKIE_AGE: Session cookie age in seconds (default: 1 hour)
SESSION_COOKIE_AGE=3600

# ============================================================================
# FILE STORAGE (AWS S3 or Local)
# ============================================================================
# USE_S3: Use AWS S3 for media storage (True) or local storage (False)
USE_S3=False

# AWS S3 Settings (if USE_S3=True)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=your_bucket_name.s3.amazonaws.com

# ============================================================================
# TIMEZONE & LOCALIZATION
# ============================================================================
# TIME_ZONE: Timezone for the application
# Examples: UTC, America/New_York, Europe/London, Asia/Dubai
TIME_ZONE=UTC

# LANGUAGE_CODE: Default language code
LANGUAGE_CODE=en-us

# ============================================================================
# MEDIA & STATIC FILES
# ============================================================================
# MEDIA_ROOT: Directory for uploaded files
MEDIA_ROOT=media

# STATIC_ROOT: Directory for collected static files
STATIC_ROOT=staticfiles

# MEDIA_URL: URL prefix for media files
MEDIA_URL=/media/

# STATIC_URL: URL prefix for static files
STATIC_URL=/static/

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
# DJANGO_DEBUG_TOOLBAR: Enable Django Debug Toolbar (True for dev only)
# DJANGO_DEBUG_TOOLBAR=True

# ============================================================================
# BACKUP SETTINGS
# ============================================================================
# BACKUP_ENABLED: Enable automatic backups
BACKUP_ENABLED=True

# BACKUP_DIR: Directory for database backups
BACKUP_DIR=/var/backups/hotel_pms

# BACKUP_RETENTION_DAYS: Days to keep backups
BACKUP_RETENTION_DAYS=30

# ============================================================================
# RATE LIMITING
# ============================================================================
# RATELIMIT_ENABLE: Enable rate limiting (True recommended)
RATELIMIT_ENABLE=True

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env file to version control!
# 2. Use strong, unique SECRET_KEY in production
# 3. Set DEBUG=False in production
# 4. Enable SSL/HTTPS in production
# 5. Use environment-specific .env files (.env.production, .env.staging)
# 6. Store sensitive credentials in secure vault (AWS Secrets Manager, etc.)
# 7. Review all settings before deploying to production
# ============================================================================
